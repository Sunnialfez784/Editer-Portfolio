# ---- Frontend (Vite) ----
# Same-domain deploy hai isliye relative path use karo, poora URL nahi chahiye.
VITE_BASE_URL=/api/v1/videos

# ---- Backend (Vercel Environment Variables me dalo) ----
NODE_ENV=production

# DB (production block config/config.json me DB_URL use karta hai)
DB_URL=mysql://user:password@host:3306/dbname

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
